{
  "consumer": {
    "name": "ministore-frontend"
  },
  "interactions": [
    {
      "description": "a request for orders",
      "pending": false,
      "request": {
        "matchingRules": {
          "query": {
            "limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/orders",
        "query": {
          "limit": [
            "10"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "items": [
              {
                "customer": "某人",
                "id": null,
                "price": null,
                "qty": null,
                "status": "created"
              }
            ],
            "total": null
          },
          "contentType": "application/json",
          "encoded": false
        },
        "generators": {
          "body": {
            "$.items[*].id": {
              "max": 10,
              "min": 0,
              "type": "RandomInt"
            },
            "$.items[*].price": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$.items[*].qty": {
              "max": 10,
              "min": 0,
              "type": "RandomInt"
            },
            "$.total": {
              "max": 10,
              "min": 0,
              "type": "RandomInt"
            }
          }
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*].customer": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.items[*].price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.items[*].qty": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.items[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to create an order",
      "pending": false,
      "request": {
        "body": {
          "content": {
            "customer": "契约员",
            "item": "测试商品",
            "price": 9.9,
            "qty": 1
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/api/orders"
      },
      "response": {
        "body": {
          "content": {
            "customer": "契约员",
            "id": null,
            "status": "created"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "generators": {
          "body": {
            "$.id": {
              "max": 10,
              "min": 0,
              "type": "RandomInt"
            }
          }
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.customer": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "ministore-api"
  }
}