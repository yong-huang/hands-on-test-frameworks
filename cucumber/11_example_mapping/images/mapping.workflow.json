{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Example Mapping：三色卡到红绿闭环",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "locale": "zh-CN",
