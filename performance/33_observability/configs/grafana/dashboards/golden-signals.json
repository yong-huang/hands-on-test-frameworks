{
  "title": "黄金信号 · 双 SUT",
  "uid": "perf-golden",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "① 流量：RPS（按 handler）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (handler, job) (rate(http_requests_total[1m]))", "legendFormat": "{{job}} {{handler}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "② 延迟：P95（服务级）",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "shorturl" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket[1m])) by (le))", "legendFormat": "shop" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "③ 错误：非 2xx 比率",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status!~\"2..\"}[1m])) / sum(rate(http_requests_total[1m]))", "legendFormat": "error-rate" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "④ 资源：进程 CPU（核/秒）",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "④ 资源：进程常驻内存 RSS",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "存储：PG 事务速率 / Redis 命中",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit[1m])", "legendFormat": "pg commits" },
        { "expr": "rate(redis_keyspace_hits_total[1m])", "legendFormat": "redis hits" },
        { "expr": "rate(redis_keyspace_misses_total[1m])", "legendFormat": "redis misses" }
      ]
    }
  ]
}
